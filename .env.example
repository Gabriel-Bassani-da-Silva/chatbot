# ============================================================
# Variáveis de ambiente — NÃO commitar o .env real no Git!
# Copie este arquivo para .env e preencha os valores.
# Use: openssl rand -hex 32   para gerar chaves seguras.
# Versões das imagens Docker: ver versions.env (commitado).
# ============================================================

# ------------------------------------------------------------
# Variáveis Globais
# ------------------------------------------------------------
DOMAIN=SEU_DOMINIO_AQUI

# ------------------------------------------------------------
# n8n
# ------------------------------------------------------------
# URL pública usada nos webhooks (deve ser acessível externamente)
WEBHOOK_URL=
N8N_EDITOR_BASE_URL=
# URL base do MCP (opcional; usado apenas se o MCP estiver ativo)
N8N_MCP_BASE_URL=
# Chave de criptografia dos dados sensíveis armazenados pelo n8n
N8N_ENCRYPTION_KEY=

# ------------------------------------------------------------
# PostgreSQL — banco interno do n8n
# ------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Nome do banco da aplicação (criado automaticamente pelo postgres-init.sql)
APP_DB_NAME=

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_PASSWORD=

# ------------------------------------------------------------
# WAHA (WhatsApp HTTP API)
# ------------------------------------------------------------
# Chave de autenticação da API REST do WAHA
WAHA_API_KEY=
# Deve ser idêntico ao WAHA_API_KEY — usado internamente pelo WAHA Apps (integração Chatwoot)
WAHA_API_KEY_PLAIN=
# Porta exposta do WAHA no host
WAHA_PORT=3000
# Dashboard de sessões → http://localhost:${WAHA_PORT:-3000}/dashboard
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=
# Swagger (docs interativos da API) → http://localhost:3000/
WHATSAPP_SWAGGER_USERNAME=
WHATSAPP_SWAGGER_PASSWORD=

# ------------------------------------------------------------
# Cloudflare Tunnel
# ------------------------------------------------------------
TUNNEL_TOKEN=

# ------------------------------------------------------------
# Chatwoot
# ------------------------------------------------------------
# URL pública do frontend (subdomínio dedicado via Cloudflare Tunnel)
CHATWOOT_FRONTEND_URL=https://chatwoot.SEU_DOMINIO
# Porta exposta do Chatwoot no host
CHATWOOT_PORT=3001
# ID da conta Chatwoot; default usado pelos scripts: 1
CHATWOOT_ACCOUNT_ID=1
# Banco de dados dedicado ao Chatwoot (criado automaticamente pelo postgres-init.sql)
CHATWOOT_POSTGRES_DATABASE=chatwoot_production
CHATWOOT_POSTGRES_USERNAME=chatwoot
CHATWOOT_POSTGRES_PASSWORD=
# Chave secreta do Rails (SECRET_KEY_BASE)
CHATWOOT_SECRET_KEY_BASE=

# --- Variáveis para integração com WAHA ---
CHATWOOT_ACCOUNT_TOKEN=
CHATWOOT_INBOX_ID=
CHATWOOT_INBOX_IDENTIFIER=
CHATWOOT_BOT_ID=
CHATWOOT_BOT_TOKEN=
# Marcador local usado para retomar sem repetir a associação
CHATWOOT_BOT_LINKED_INBOX_ID=
# ------------------------------------------------------------
# Backup do PostgreSQL (postgres-backup)
# ------------------------------------------------------------
# Bancos a fazer backup, separados por vírgula ou espaço.
# Exemplo: POSTGRES_BACKUP_DATABASES=n8n,chatwoot_production
# Se não definido, usa o valor de POSTGRES_DB (somente n8n).
# POSTGRES_BACKUP_DATABASES=n8n,chatwoot_production