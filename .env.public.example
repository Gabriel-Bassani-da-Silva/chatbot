# ==============================================================================
# Configuração Pública — Cópia modelo para produção com Cloudflare Tunnel
# ==============================================================================
# Fluxo de uso:
#   1. cp .env.public.example .env
#   2. Preencha seu DOMAIN e TUNNEL_TOKEN da Cloudflare
#   3. Preencha as chaves e senhas obrigatórias (gere com: openssl rand -hex 32)
#   4. make up
#   5. Acesse https://chatwoot.<seu-dominio>, crie a conta de Admin e copie o Token
#   6. python3 scripts/setup.py
#
# Para testes apenas locais sem túnel/internet, use: .env.example
# As versões das imagens Docker estão fixadas em: versions.env
# ==============================================================================


# ==============================================================================
# 1. Domínio & Cloudflare Tunnel
# ==============================================================================
# Hostname principal do seu domínio (sem https://, caminho ou barra final):
DOMAIN=SEU_DOMINIO_AQUI

# Token do Cloudflare Tunnel que publica os serviços externamente:
# Obtenha em: https://dash.cloudflare.com/ (Networks > Tunnels)
TUNNEL_TOKEN=


# ==============================================================================
# 2. Infraestrutura Central (PostgreSQL & Redis)
# ==============================================================================
# O cluster PostgreSQL hospeda 3 bancos de dados independentes:
#   - 'n8n': Banco interno do n8n (usa o superusuário postgres)
#   - 'chatwoot_production': Banco do Chatwoot (usa o usuário dedicado chatwoot)
#   - 'chatbot': Banco da aplicação/RAG com suporte a pgvector

# Superusuário do PostgreSQL (usado pelo n8n e pela administração do banco):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# Banco adicional da aplicação/bot (criado automaticamente na inicialização):
APP_DB_NAME=chatbot

# Senha do Redis (cache e fila de mensageria compartilhada):
REDIS_PASSWORD=

# Backup automático diário (salvo em ./bkp):
# Descomente para incluir todos os bancos no backup das 03:00.
# POSTGRES_BACKUP_DATABASES=n8n,chatwoot_production,chatbot
# POSTGRES_BACKUP_SCHEDULE=0 3 * * *
# POSTGRES_BACKUP_KEEP_DAYS=7
# POSTGRES_BACKUP_KEEP_WEEKS=0
# POSTGRES_BACKUP_KEEP_MONTHS=0


# ==============================================================================
# 3. n8n (Motor de Automações)
# ==============================================================================
# URLs públicas protegidas por HTTPS e roteadas pelo Cloudflare Tunnel:
N8N_WEBHOOK_URL=https://n8n.SEU_DOMINIO
N8N_EDITOR_BASE_URL=https://n8n.SEU_DOMINIO
N8N_MCP_BASE_URL=https://n8n.SEU_DOMINIO

# Chave obrigatória para criptografar credenciais salvas no n8n:
N8N_ENCRYPTION_KEY=

# Cookie seguro ativado em ambiente HTTPS público:
N8N_SECURE_COOKIE=true


# ==============================================================================
# 4. WAHA (WhatsApp HTTP API)
# ==============================================================================
# Porta local do serviço WAHA (acesso direto restrito ao host):
WAHA_PORT=3000

# Motor do WhatsApp (NOWEB: WebSocket direto via Baileys, leve e estável):
WHATSAPP_DEFAULT_ENGINE=NOWEB

# Chave secreta de autenticação da API HTTP do WhatsApp:
WAHA_API_KEY=
# Deve ter exatamente o mesmo valor de WAHA_API_KEY (usado pelo WAHA Apps):
WAHA_API_KEY_PLAIN=

# Credenciais de acesso ao Dashboard web (http://localhost:3000/dashboard):
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# Swagger / Documentação interativa da API (desativado por padrão):
# WHATSAPP_SWAGGER_ENABLED=false
# WHATSAPP_SWAGGER_USERNAME=
# WHATSAPP_SWAGGER_PASSWORD=


# ==============================================================================
# 5. Chatwoot (Central de Atendimento)
# ==============================================================================
CHATWOOT_FRONTEND_URL=https://chatwoot.SEU_DOMINIO
CHATWOOT_PORT=3001
CHATWOOT_ACCOUNT_ID=1

# Segredo do Rails para assinatura de cookies e sessões:
CHATWOOT_SECRET_KEY_BASE=

# Credenciais exclusivas do Chatwoot no PostgreSQL (usuário não-root):
CHATWOOT_POSTGRES_DATABASE=chatwoot_production
CHATWOOT_POSTGRES_USERNAME=chatwoot
CHATWOOT_POSTGRES_PASSWORD=

# ------------------------------------------------------------------------------
# Pós-Inicialização: Integração do Agent Bot (preenchido após `make up`)
# ------------------------------------------------------------------------------
# Token pessoal do Administrador (MANUAL — preencher após 1º login no Chatwoot):
# Obtenha em: Chatwoot > Foto de Perfil (canto inf. esq.) > Profile Settings > Access Token
CHATWOOT_ACCOUNT_TOKEN=

# Campos preenchidos AUTOMATICAMENTE ao rodar `python3 scripts/setup.py`:
# (Deixe vazios inicialmente. O script cria os recursos e salva os IDs abaixo)
# 1. ID numérico da Inbox 'WhatsApp WAHA' criada no Chatwoot:
CHATWOOT_INBOX_ID=
# 2. Identificador/hash da Inbox usado pelo WAHA para rotear mensagens:
CHATWOOT_INBOX_IDENTIFIER=
# 3. ID numérico do Agent Bot ('Assistente RAG') criado no Chatwoot:
CHATWOOT_BOT_ID=
# 4. Token do Agent Bot para webhook seguro com o n8n:
CHATWOOT_BOT_TOKEN=
# 5. Confirmação do vínculo entre o Agent Bot e a Inbox:
CHATWOOT_BOT_LINKED_INBOX_ID=
