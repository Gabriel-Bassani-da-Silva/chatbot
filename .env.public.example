# ============================================================
# Configuração pública — não commite o arquivo .env real.
#
# Fluxo inicial:
#   1. cp .env.public.example .env
#   2. preencha os campos obrigatórios abaixo
#   3. make public up
#   4. python3 scripts/setup.py
#
# O modo público usa compose.yml + compose.public.yml.
# Gere chaves aleatórias com: openssl rand -hex 32
# As versões das imagens Docker ficam em versions.env.
# ============================================================

# ------------------------------------------------------------
# Domínio público
# ------------------------------------------------------------
# Hostname sem https://, caminho ou barra final.
DOMAIN=SEU_DOMINIO_AQUI

# ------------------------------------------------------------
# n8n público
# ------------------------------------------------------------
# URL pública usada pelo n8n para gerar webhooks.
WEBHOOK_URL=https://n8n.SEU_DOMINIO
N8N_EDITOR_BASE_URL=https://n8n.SEU_DOMINIO

# URL base opcional do MCP do n8n.
N8N_MCP_BASE_URL=

# Chave obrigatória para criptografar credenciais e dados sensíveis do n8n.
N8N_ENCRYPTION_KEY=

# O modo público usa HTTPS pelo Caddy/Cloudflare Tunnel.
N8N_SECURE_COOKIE=true

# ------------------------------------------------------------
# PostgreSQL — banco interno do n8n
# ------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Banco adicional criado por postgres-init.sql na primeira inicialização
# de um volume vazio. O projeto usa o banco "fatec".
APP_DB_NAME=fatec

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_PASSWORD=

# ------------------------------------------------------------
# WAHA — WhatsApp HTTP API
# ------------------------------------------------------------
WAHA_API_KEY=

# Deve ser exatamente igual a WAHA_API_KEY; é usado pelo WAHA Apps.
WAHA_API_KEY_PLAIN=
WAHA_PORT=3000
WAHA_DASHBOARD_USERNAME=
WAHA_DASHBOARD_PASSWORD=

# Swagger desativado por padrão; preencha somente se for habilitá-lo.
WHATSAPP_SWAGGER_USERNAME=
WHATSAPP_SWAGGER_PASSWORD=

# ------------------------------------------------------------
# Cloudflare Tunnel
# ------------------------------------------------------------
# Token do Tunnel que publica o Caddy pelos hostnames configurados.
TUNNEL_TOKEN=

# ------------------------------------------------------------
# Chatwoot público
# ------------------------------------------------------------
CHATWOOT_FRONTEND_URL=https://chatwoot.SEU_DOMINIO
CHATWOOT_PORT=3001
CHATWOOT_ACCOUNT_ID=1

CHATWOOT_POSTGRES_DATABASE=chatwoot_production
CHATWOOT_POSTGRES_USERNAME=chatwoot
CHATWOOT_POSTGRES_PASSWORD=
CHATWOOT_SECRET_KEY_BASE=

# Access Token da conta Chatwoot usado pelo setup.py para chamar a API.
CHATWOOT_ACCOUNT_TOKEN=

# Deixe vazios na instalação nova: o setup.py preencherá após criar a Inbox.
# Para reutilizar uma Inbox, preencha ID e identificador juntos.
CHATWOOT_INBOX_ID=
CHATWOOT_INBOX_IDENTIFIER=

# O setup.py preenche estes campos ao criar ou reutilizar o Agent Bot.
CHATWOOT_BOT_ID=
CHATWOOT_BOT_TOKEN=
CHATWOOT_BOT_LINKED_INBOX_ID=

# ------------------------------------------------------------
# Backup do PostgreSQL
# ------------------------------------------------------------
# Se não definidos, os valores padrão do Compose são usados.
# POSTGRES_BACKUP_DATABASES=n8n,chatwoot_production
# POSTGRES_BACKUP_SCHEDULE=0 3 * * *
# POSTGRES_BACKUP_KEEP_DAYS=7
# POSTGRES_BACKUP_KEEP_WEEKS=0
# POSTGRES_BACKUP_KEEP_MONTHS=0
