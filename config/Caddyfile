# O Caddy escuta na :80 e roteia pelo hostname.
# No template, o Cloudflare Tunnel deve ter três Public Hostnames para http://caddy:80:
#   - {$DOMAIN}          → http://caddy:80
#   - n8n.{$DOMAIN}      → http://caddy:80
#   - chatwoot.{$DOMAIN} → http://caddy:80

# Domínio principal público — somente a página inicial (sem endpoints de controle local)
{$DOMAIN}:80 {
    handle {
        root * /srv/public
        templates
        file_server
    }
}

# Acesso local restrito — página inicial e endpoint sob demanda para reiniciar containers locais
localhost:80 {
    # Endpoint seguro: reinicia apenas containers da stack chatbot_n8n
    @dockerRestart {
        method POST
        path_regexp restart ^/api/docker/restart/([a-zA-Z0-9_\-]+)$
    }
    handle @dockerRestart {
        @allowedContainers path_regexp ^/api/docker/restart/(chatbot_n8n-[a-zA-Z0-9_\-]+)$
        handle @allowedContainers {
            rewrite * /containers/{re.restart.1}/restart
            reverse_proxy unix//var/run/docker.sock
        }
        respond "Container não permitido" 403
    }

    # Página inicial estática
    handle {
        root * /srv/public
        templates
        file_server
    }
}

# Subdomínio dedicado ao n8n
n8n.{$DOMAIN}:80 {
    reverse_proxy n8n:5678 {
        # Necessário para WebSocket (editor em tempo real) e webhooks
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto https
    }
}

# Subdomínio dedicado ao Chatwoot
chatwoot.{$DOMAIN}:80 {
    reverse_proxy chatwoot-web:3000
}
