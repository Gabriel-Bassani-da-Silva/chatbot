    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const envelope = $json.body ?? $json;\nconst payload = envelope.payload ?? envelope;\nconst media = payload.media ?? {};\nconst timestamp = Number(envelope.timestamp ?? payload.timestamp ?? Date.now());\nconst receivedAt = timestamp < 100000000000 ? timestamp * 1000 : timestamp;\nconst chatId = String(payload.from ?? payload.to ?? \"\");\nconst fromMe = Boolean(payload.fromMe ?? payload.key?.fromMe ?? false);\nconst messageId = String(payload.id ?? envelope.id ?? (chatId + \":\" + receivedAt));\nreturn { json: {\n  source: \"waha\",\n  channel: \"waha\",\n  from_me: fromMe,\n  session: String(envelope.session ?? \"default\"),\n  session_id: chatId,\n  conversation_id: chatId,\n  user_id: chatId,\n  chat_id: chatId,\n  message_id: messageId,\n  waha_message_id: messageId,\n  text: String(payload.body ?? \"\"),\n  caption: String(payload.body ?? \"\"),\n  mime_type: String(media.mimetype ?? \"\"),\n  media_url: String(media.url ?? \"\"),\n  received_at: new Date(receivedAt).toISOString(),\n  received_at_ms: receivedAt,\n  queue_key: \"waha:queue:\" + (chatId || \"unknown\"),\n  input_type: media.mimetype?.startsWith(\"image/\") ? (payload.body ? \"image_with_caption\" : \"image\") : media.mimetype?.startsWith(\"audio/\") ? \"audio\" : (media.url || payload.hasMedia) ? \"document\" : \"text\"\n} };"
      },
