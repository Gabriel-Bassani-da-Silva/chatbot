{
  "id": "rag_model_change_sync",
  "name": "RAG - Monitor de Mudanca de Modelo de Embedding",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {},
      "id": "manual-check-model",
      "name": "Disparo Manual (Sob Demanda)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sincronizar-modelo-embedding",
        "options": {
          "responseMode": "onReceived"
        }
      },
      "id": "webhook-check-model",
      "name": "Webhook - Sincronizar Modelo de Embedding",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        400
      ],
      "webhookId": "sync-embedding-model-001"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "\nWITH config_model AS (\n  SELECT n->'parameters'->>'model' AS active_model\n  FROM workflow_entity w, LATERAL json_array_elements(w.nodes) AS n\n  WHERE w.id = 'vKrMSyZ4jMDtbjW7' AND n->>'type' = '@n8n/n8n-nodes-langchain.embeddingsOllama'\n  LIMIT 1\n),\ncurrent_vectors AS (\n  SELECT cmetadata->>'model' AS vector_model\n  FROM fatec_rag_vectors_poc\n  WHERE cmetadata->>'model' IS NOT NULL\n  LIMIT 1\n)\nSELECT \n  COALESCE(c.active_model, 'qwen3-embedding:0.6b') AS active_model,\n  COALESCE(v.vector_model, 'none') AS current_vector_model,\n  CASE WHEN COALESCE(c.active_model, '') <> COALESCE(v.vector_model, '') THEN true ELSE false END AS model_changed\nFROM config_model c FULL JOIN current_vectors v ON true;\n",
        "options": {}
      },
      "id": "compare-embedding-models",
      "name": "Postgres - Comparar Modelo Configurado vs Ingerido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        520,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "WXVjpdoSEtoJGCvg",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json.model_changed }}",
              "operator": {
                "type": "boolean",
                "operation": "equals"
              },
              "rightValue": true
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-if-model-changed",
      "name": "Modelo de Embedding Mudou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:11434/api/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $json.active_model }}\",\n  \"prompt\": \"teste de dimensao\"\n}",
        "options": {}
      },
      "id": "probe-ollama-dimension",
      "name": "Ollama - Provar Dimensao do Novo Modelo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1060,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst emb = $json.embedding || [];\nconst dim = emb.length || 1024;\nconst activeModel = $('Postgres - Comparar Modelo Configurado vs Ingerido').item.json.active_model;\n\nconst sql = `\nDROP INDEX IF EXISTS idx_fatec_vectors_cosine;\nALTER TABLE fatec_rag_vectors_poc ALTER COLUMN embedding TYPE vector(${dim});\nCREATE INDEX IF NOT EXISTS idx_fatec_vectors_cosine ON fatec_rag_vectors_poc USING hnsw (embedding vector_cosine_ops);\n`;\n\nreturn {\n  json: {\n    active_model: activeModel,\n    dim,\n    alter_sql: sql\n  }\n};\n"
      },
      "id": "calculate-dim-and-sql",
      "name": "Calcular Dimensao e Gerar SQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1300,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.alter_sql }}",
        "options": {}
      },
      "id": "postgres-update-column-index",
      "name": "Postgres - Ajustar Coluna e Indice PGVector",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1540,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "WXVjpdoSEtoJGCvg",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "gdrive_rag_sync1"
        },
        "mode": "each",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "trigger-gdrive-resync",
      "name": "Disparar Sincronizacao Google Drive",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [
        1780,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst info = $json;\nreturn {\n  json: {\n    status: 'unchanged',\n    message: `Modelo ${info.active_model} continua o mesmo. Nenhuma ação necessária.`\n  }\n};\n"
      },
      "id": "model-unchanged-node",
      "name": "Modelo Nao Mudou (Sem Acao)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1060,
        420
      ]
    }
  ],
  "connections": {
    "Disparo Manual (Sob Demanda)": {
      "main": [
        [
          {
            "node": "Postgres - Comparar Modelo Configurado vs Ingerido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook - Sincronizar Modelo de Embedding": {
      "main": [
        [
          {
            "node": "Postgres - Comparar Modelo Configurado vs Ingerido",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Comparar Modelo Configurado vs Ingerido": {
      "main": [
        [
          {
            "node": "Modelo de Embedding Mudou?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Modelo de Embedding Mudou?": {
      "main": [
        [
          {
            "node": "Ollama - Provar Dimensao do Novo Modelo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Modelo Nao Mudou (Sem Acao)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama - Provar Dimensao do Novo Modelo": {
      "main": [
        [
          {
            "node": "Calcular Dimensao e Gerar SQL",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Calcular Dimensao e Gerar SQL": {
      "main": [
        [
          {
            "node": "Postgres - Ajustar Coluna e Indice PGVector",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Postgres - Ajustar Coluna e Indice PGVector": {
      "main": [
        [
          {
            "node": "Disparar Sincronizacao Google Drive",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}