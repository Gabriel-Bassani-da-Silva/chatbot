    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Entrada do workflow principal').item.json ?? {};\nconst text = String(original.contentText ?? '').trim();\nconst parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Sao_Paulo', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(new Date());\nconst local = Object.fromEntries(parts.map(p => [p.type, p.value]));\nconst currentLocal = `${local.year}-${local.month}-${local.day} ${local.hour}:${local.minute}`;\nconst directReply = text.toLocaleLowerCase('pt-BR') === '/agenda' ? 'Vamos agendar uma consulta de 30 minutos. Para começar, informe seu nome, o motivo da consulta, a data e o horário que prefere. Ainda não consultei a disponibilidade.' : '';\nreturn { json: { ...original, promptInput: JSON.stringify({ current_datetime_sao_paulo: currentLocal, timezone: 'America/Sao_Paulo', user_message: text }), directReply } };"
      },
