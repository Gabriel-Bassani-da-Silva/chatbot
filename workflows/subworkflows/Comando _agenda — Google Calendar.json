    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const original = $('Entrada do workflow principal').item.json ?? {};\nconst text = String(original.contentText ?? '').trim();\nconst raw = $json.output ?? $json;\nconst parsed = raw && typeof raw === 'object' ? raw : {};\nconst clean = value => typeof value === 'string' && value.trim() ? value.trim() : null;\nlet nome = clean(parsed.nome);\nlet assunto = clean(parsed.assunto);\nlet data = clean(parsed.data);\nlet hora = clean(parsed.hora);\nconst sessionKey = String(original.appSessionKey ?? '');\nlet oldState = null;\ntry {\n  const value = $('Redis — ler confirmação').item.json.pendingState;\n  oldState = typeof value === 'string' ? JSON.parse(value) : (value && typeof value === 'object' ? value : null);\n} catch { oldState = null; }\nconst stateAge = oldState ? Date.now() - Number(oldState.summaryAt ?? 0) : Number.POSITIVE_INFINITY;\nconst sameSession = oldState && oldState.sessionKey === sessionKey;\nconst norm = value => String(value ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').toLowerCase().replace(/[.!?,;]+/g, ' ').replace(/\\s+/g, ' ').trim();\nconst affirmative = /^(sim|confirmo|isso mesmo|pode agendar|pode marcar|esta certo|tudo certo|correto|confirmado|pode fechar)$/.test(norm(text));\nfunction result(action, output, extra = {}) { return { json: { ...original, action, output, ...extra } }; }\nfunction pending(output, summaryAt) { return result('pending', output, { pendingState: JSON.stringify({ sessionKey, summaryAt }) }); }\nif (/^\\/cancelar$/i.test(text)) return pending('Solicitação de agendamento cancelada. Nenhum evento foi consultado ou criado.', 0);\nif (nome && nome.length > 120) nome = null;\nif (assunto && assunto.length > 240) assunto = null;\nlet dateParts = null;\nif (data) {\n  let m = data.match(/^(\\d{2})\\/(\\d{2})\\/(\\d{4})$/);\n  if (m) dateParts = { day: Number(m[1]), month: Number(m[2]), year: Number(m[3]) };\n  else {\n    m = data.match(/^(\\d{4})-(\\d{2})-(\\d{2})$/);\n    if (m) dateParts = { year: Number(m[1]), month: Number(m[2]), day: Number(m[3]) };\n  }\n  if (!dateParts) data = null;\n}\nlet timeParts = null;\nif (hora) {\n  const m = hora.match(/^([01]\\d|2[0-3]):([0-5]\\d)$/);\n  if (m) timeParts = { hour: Number(m[1]), minute: Number(m[2]) };\n  else hora = null;\n}\nif (dateParts) {\n  const d = new Date(Date.UTC(dateParts.year, dateParts.month - 1, dateParts.day));\n  if (d.getUTCFullYear() !== dateParts.year || d.getUTCMonth() !== dateParts.month - 1 || d.getUTCDate() !== dateParts.day) { data = null; dateParts = null; }\n}\nif (!nome || !assunto || !data || !hora || !dateParts || !timeParts) {\n  const missing = [];\n  if (!nome) missing.push('seu nome');\n  if (!assunto) missing.push('o motivo da consulta');\n  if (!data) missing.push('a data (pode dizer, por exemplo, “amanhã”)');\n  if (!hora) missing.push('o horário');\n  return pending('Vamos agendar uma consulta de 30 minutos. Para continuar, informe ' + missing.join(', ') + '. Ainda não consultei a agenda.', 0);\n}\nconst start = new Date(Date.UTC(dateParts.year, dateParts.month - 1, dateParts.day, timeParts.hour + 3, timeParts.minute));\nif (!Number.isFinite(start.getTime()) || start.getTime() <= Date.now()) return pending('Essa data e horário já passaram ou não são válidos. Informe uma data e hora futuras no horário de São Paulo.', 0);\nconst end = new Date(start.getTime() + 30 * 60 * 1000);\nconst dayText = String(dateParts.day).padStart(2, '0') + '/' + String(dateParts.month).padStart(2, '0') + '/' + dateParts.year;\nconst timeText = String(timeParts.hour).padStart(2, '0') + ':' + String(timeParts.minute).padStart(2, '0');\nconst displayDate = dayText + ' às ' + timeText + ' (horário de São Paulo)';\nif (affirmative && sameSession && stateAge >= 0 && stateAge <= 30 * 60 * 1000) {\n  const digits = value => String(value).replace(/\\D/g, '');\n  const eventId = 'agenda' + digits(original.conversationId) + 'm' + digits(original.messageId);\n  return result('calendar', '', { nome, assunto, displayDate, startISO: start.toISOString(), endISO: end.toISOString(), eventId, eventTitle: 'Consulta — ' + assunto, eventDescription: 'Nome: ' + nome + '\\nAssunto: ' + assunto + '\\nDuração: 30 minutos' });\n}\nconst summary = 'Resumo do agendamento:\\nNome: ' + nome + '\\nAssunto: ' + assunto + '\\nData e hora: ' + displayDate + '\\nDuração: 30 minutos.\\n\\nPosso consultar a disponibilidade e criar o evento privado? Responda “sim” ou diga o que deseja alterar. A agenda ainda não foi consultada.';\nreturn pending(summary, Date.now());"
      },
