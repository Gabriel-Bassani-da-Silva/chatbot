    "perguntas_frequentes": [
        {
            "pergunta": "Quais disciplinas tem o 1º semestre de Logística?",
            "resposta": "Projeto Interdisciplinar I (80 aulas, remoto), Logística Empresarial, Informática Aplicada à Logística, Matemática Aplicada (80 aulas cada), Métodos para Produção do Conhecimento, Fundamentos de Administração, Fundamentos de Comunicação e Expressão e Inglês para Logística I (40 aulas cada)."
        },
        {
            "pergunta": "Qual a carga horária total do curso de Logística?",
            "resposta": "2880 aulas, equivalentes a 2400 horas, mais 240 horas de estágio."
        },
        {
            "pergunta": "O Projeto Interdisciplinar de Logística é presencial?",
            "resposta": "Não. Os Projetos Interdisciplinares (I a VI), de 80 aulas cada, são em modalidade remota."
        },
        {
            "pergunta": "Logística tem Espanhol?",
            "resposta": "Sim, Espanhol I (2º semestre) e Espanhol II (3º semestre), de 40 aulas cada."
        },
        {
            "pergunta": "Quais disciplinas tem o 6º semestre de Logística?",
            "resposta": "Projeto Interdisciplinar VI (remoto), Gestão de Transporte de Carga e Roteirização, Comércio Exterior e Logística (80 aulas cada), Logística Digital, Transporte de Cargas Especiais e Perigosas, Tecnologia de Transportes, Inovação e Empreendedorismo, Tópicos Avançados em Logística e Consultoria e Tomada de Decisão em Logística (40 aulas cada)."
        },
        {
            "pergunta": "Em qual semestre estudo logística aplicada ao agronegócio?",
            "resposta": "Logística de Abastecimento Aplicada ao Agronegócio no 4º semestre e Logística Distributiva Aplicada ao Agronegócio no 5º semestre (40 aulas cada)."
        },
        {
            "pergunta": "Qual matriz vale para mim?",
            "resposta": "Depende do ano de ingresso. Confirme sua turma antes de definir a matriz aplicável."
        }
    ]
